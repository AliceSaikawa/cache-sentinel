{
  "name": "cache-sentinel",
  "version": "0.6.0-rc.3",
  "description": "DSH host plugin that guards against uncached prompts: blocks sends (read-only) and/or archives sessions after the prompt cache likely expired.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-cache",
    "cache"
  ],
  "author": "AliceSaikawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliceSaikawa/cache-sentinel.git"
  },
  "homepage": "https://github.com/AliceSaikawa/cache-sentinel#readme",
  "bugs": {
    "url": "https://github.com/AliceSaikawa/cache-sentinel/issues"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
